/* ==========================================================================
   SmartAI Industrial Monitor - industrial dark theme
   ==========================================================================

   Design constraints, in priority order.  These are HMI decisions, not
   aesthetic ones:

   1. Status colours are reserved.  Green / amber / red / grey mean exactly one
      thing each and are used for nothing else in the interface.  A red button
      that is merely "destructive" and an amber heading that is merely "a
      heading" both dilute the vocabulary an operator reads the plant with.

   2. Chroma is low everywhere except status.  The background is near-neutral
      and the accent is a single desaturated blue, so the only saturated pixels
      on screen are the ones carrying information.

   3. Contrast is sized for a shop floor.  Body text sits around 9:1 against its
      background - well past WCAG AA - because the screens this runs on are
      frequently viewed at an angle, under glare, through a cabinet window.

   4. Nothing animates that carries meaning.  A colour change is instantaneous;
      a transition would make an alarm look like a decoration.

   Selectors are grouped by widget role rather than by widget class wherever
   possible, so a new panel that uses the same object names inherits the style
   without touching this file.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Palette
   -------------------------------------------------------------------------- */
QWidget {
    background-color: #10141a;
    color: #d6dde6;
    font-family: "Segoe UI", "Microsoft YaHei UI", Roboto, Arial, sans-serif;
    font-size: 12px;
}

QMainWindow, QDialog {
    background-color: #0c1015;
}

QWidget#CentralContainer,
QWidget#DashboardPage,
QWidget#ChartPage,
QWidget#LogPage {
    background-color: #10141a;
}

/* --------------------------------------------------------------------------
   Panels - the raised surfaces.  Every logical group of controls sits in one,
   so a glance at the screen shows the block structure of the application.
   -------------------------------------------------------------------------- */
QFrame#Panel, QGroupBox {
    background-color: #161c24;
    border: 1px solid #232c38;
    border-radius: 4px;
}

QGroupBox {
    margin-top: 16px;
    padding: 10px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #8b97a6;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#PanelTitle {
    color: #8b97a6;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 0;
}

QLabel#PanelHint {
    color: #63707f;
    font-size: 11px;
}

QLabel#SectionHeading {
    color: #e8eef5;
    font-size: 13px;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   Menu bar and tool bar
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #0c1015;
    border-bottom: 1px solid #232c38;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 11px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #1c2530;
    color: #e8eef5;
}

QMenu {
    background-color: #161c24;
    border: 1px solid #232c38;
    padding: 5px;
}

QMenu::item {
    padding: 6px 26px 6px 22px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #24405f;
    color: #e8eef5;
}

QMenu::separator {
    height: 1px;
    background: #232c38;
    margin: 5px 8px;
}

QToolBar {
    background-color: #12171e;
    border-bottom: 1px solid #232c38;
    spacing: 4px;
    padding: 5px 8px;
}

QToolBar::separator {
    width: 1px;
    background: #232c38;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 5px 10px;
    color: #c3ccd8;
}

QToolButton:hover {
    background-color: #1c2530;
    border-color: #2b3442;
    color: #e8eef5;
}

QToolButton:pressed {
    background-color: #24405f;
}

QToolButton:checked {
    background-color: #24405f;
    border-color: #3d7fd6;
    color: #ffffff;
}

QToolButton:disabled {
    color: #4c5764;
}

/* --------------------------------------------------------------------------
   Push buttons
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #1c2530;
    border: 1px solid #2b3442;
    border-radius: 3px;
    padding: 6px 14px;
    color: #d6dde6;
    min-height: 16px;
}

QPushButton:hover {
    background-color: #232f3d;
    border-color: #3d7fd6;
}

QPushButton:pressed {
    background-color: #24405f;
}

QPushButton:disabled {
    background-color: #161c24;
    border-color: #212936;
    color: #4c5764;
}

QPushButton#PrimaryButton {
    background-color: #2c5f9e;
    border-color: #3d7fd6;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #3d7fd6;
}

QPushButton#DangerButton {
    background-color: #7a2b2b;
    border-color: #d64545;
    color: #ffe8e8;
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: #9c3535;
}

/* --------------------------------------------------------------------------
   Inputs
   -------------------------------------------------------------------------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #0d1117;
    border: 1px solid #2b3442;
    border-radius: 3px;
    padding: 5px 8px;
    selection-background-color: #2c5f9e;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #3d7fd6;
}

QLineEdit:disabled, QComboBox:disabled {
    color: #4c5764;
    background-color: #12171e;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #161c24;
    border: 1px solid #2b3442;
    selection-background-color: #24405f;
    outline: none;
}

/* --------------------------------------------------------------------------
   Lists, tables, trees
   -------------------------------------------------------------------------- */
QListWidget, QTreeWidget, QTableWidget, QListView, QTreeView, QTableView {
    background-color: #0d1117;
    border: 1px solid #232c38;
    border-radius: 3px;
    outline: none;
    alternate-background-color: #12171e;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 3px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #1a222c;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableView::item:selected {
    background-color: #24405f;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #161c24;
    color: #8b97a6;
    border: none;
    border-bottom: 1px solid #232c38;
    border-right: 1px solid #232c38;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
}

QTableView {
    gridline-color: #1e2732;
}

QTableCornerButton::section {
    background-color: #161c24;
    border: none;
}

/* --------------------------------------------------------------------------
   Tabs - used for the chart strip and the AI panel
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: #161c24;
    border: 1px solid #232c38;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #12171e;
    color: #8b97a6;
    border: 1px solid #232c38;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 7px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #161c24;
    color: #e8eef5;
    border-top: 2px solid #3d7fd6;
}

QTabBar::tab:hover:!selected {
    background-color: #1a222c;
    color: #c3ccd8;
}

/* --------------------------------------------------------------------------
   Scroll bars - thin, no arrows.  A scroll bar is a position indicator first;
   arrow buttons cost 30 px of width on every panel for a control nobody uses.
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2b3442;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #3a4658;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #2b3442;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a4658;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --------------------------------------------------------------------------
   Splitters - a 2 px line with a wide grab margin, so the handle is easy to
   hit without drawing a fat bar between panels.
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background-color: #0c1015;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #2c5f9e;
}

/* --------------------------------------------------------------------------
   Status bar
   -------------------------------------------------------------------------- */
QStatusBar {
    background-color: #0c1015;
    border-top: 1px solid #232c38;
    color: #8b97a6;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 2px 8px;
}

/* --------------------------------------------------------------------------
   Progress bar
   -------------------------------------------------------------------------- */
QProgressBar {
    background-color: #0d1117;
    border: 1px solid #2b3442;
    border-radius: 3px;
    text-align: center;
    color: #d6dde6;
    font-size: 11px;
    height: 16px;
}

QProgressBar::chunk {
    background-color: #2c5f9e;
    border-radius: 2px;
}

/* --------------------------------------------------------------------------
   Tooltips - high contrast, because a tooltip that is hard to read is worse
   than no tooltip: the user has already committed the hover.
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #1c2530;
    color: #e8eef5;
    border: 1px solid #3d7fd6;
    padding: 5px 8px;
    border-radius: 3px;
}

/* --------------------------------------------------------------------------
   Semantic helpers.  Applied by object name from Theme::applyState(), so the
   widgets themselves never build a stylesheet string.
   -------------------------------------------------------------------------- */
QLabel#StateNormal   { color: #3fa46a; font-weight: 600; }
QLabel#StateWarning  { color: #d9a13c; font-weight: 600; }
QLabel#StateFault    { color: #d64545; font-weight: 600; }
QLabel#StateOffline  { color: #6b7684; font-weight: 600; }

QLabel#MetricValue {
    color: #e8eef5;
    font-size: 20px;
    font-weight: 600;
}

QLabel#MetricUnit {
    color: #63707f;
    font-size: 11px;
}

QLabel#MetricCaption {
    color: #8b97a6;
    font-size: 11px;
    letter-spacing: 0.5px;
}
