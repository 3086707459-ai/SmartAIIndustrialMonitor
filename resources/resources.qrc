        <file alias="device-spindle.svg">icons/device-spindle.svg</file>
        <file alias="device-fan.svg">icons/device-fan.svg</file>
        <file alias="alarm.svg">icons/alarm.svg</file>
        <file alias="report.svg">icons/report.svg</file>
    </qresource>
</RCC>
